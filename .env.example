# DeepSeek / OpenAI-compatible model config
# Required: used by the AI Agent.
HAOSSH_AGENT_API_KEY=
HAOSSH_AGENT_MODEL_NAME=deepseek-v4-flash
HAOSSH_AGENT_BASE_URL=https://api.deepseek.com

# JWT signing key for httpOnly Cookie auth.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
HAOSSH_JWT_SECRET=

# AES-GCM key for encrypting SSH passwords/private keys at rest.
# Must be base64-encoded 32 random bytes.
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
HAOSSH_SECRET_KEY=

# Optional. Defaults to local SQLite file.
HAOSSH_DATABASE_URL=sqlite+aiosqlite:///./haossh.db

# Optional. JWT lifetime in days.
HAOSSH_JWT_EXPIRE_DAYS=7
